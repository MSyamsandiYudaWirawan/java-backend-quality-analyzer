# Build
/target/
*/target/
*.jar
*.war

# IDE
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Exception: evidence logs are committed artifacts — findings cite them
# (working agreement 4: no claim without evidence)
!evidence/**/*.log

# Local env
.env
application-local.yml

# Evidence — ignore regeneratable binary/raw outputs, keep human-readable reports
evidence/*.jfr
evidence/*.json
evidence/baseline/*.txt
evidence/advanced/*.txt
evidence/experiments/*.md~
# h3: JFR recordings + verbose event dumps regenerate via
# `run-experiment.sh <target> --docker --jfr`; the diagnosis report
# (h3/<repo>/jfr/diagnosis-report.md) and k6 JSON/reports stay committed
evidence/advanced/h3/**/*.jfr
evidence/advanced/h3/*/jfr/*.txt

# k6 binary cache (if any)
.k6/

# Python bytecode
__pycache__/
*.pyc

# Personal study materials (not part of submission)
personal/

# Local clones of analysis-target repos (controlled practice repos etc.)
targets/
